{
  "name": "israeli-bank-importer-app",
  "version": "0.2.4",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@sinclair/typebox": "^0.34.52",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.2.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.9.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "^3.9.6",
    "sonarqube-scanner": "^5.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "tar": "^7.5.21",
    "uuid": "^11.1.1",
    "brace-expansion@1": "^1.1.16",
    "brace-expansion@2": "^2.1.2",
    "brace-expansion@5": "^5.0.8"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:actions": "node scripts/lint-actions.mjs",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!CHANGELOG.md\"",
    "lint:lockfile": "node scripts/lint-lockfile.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "sonar": "sonar-scanner",
    "sonar:issues": "node scripts/sonar-issues.mjs",
    "lint:licenses": "npx --yes license-checker-rseidelsohn@4.4.2 --production --excludePrivatePackages --failOn \"AGPL-1.0;AGPL-3.0\"",
    "export": "expo export --platform android --platform ios",
    "prepare": "husky",
    "contract:check": "node scripts/check-contract.mjs",
    "contract:sync": "node scripts/check-contract.mjs --write",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json}": [
      "prettier --write"
    ],
    "!(CHANGELOG).md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "private": true
}
