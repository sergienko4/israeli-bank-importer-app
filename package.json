{
  "name": "israeli-bank-importer-app",
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "tar": "^7.5.21",
    "uuid": "^11.1.1",
    "brace-expansion@1": "^1.1.17",
    "brace-expansion@2": "^2.1.3",
    "brace-expansion@5": "^5.0.8"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:actions": "node scripts/lint-actions.mjs",
    "lint:lockfile": "node scripts/lint-lockfile.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint:licenses": "npx --yes license-checker-rseidelsohn@4.4.2 --production --excludePrivatePackages --failOn \"AGPL-1.0;AGPL-3.0\"",
    "export": "expo export --platform android --platform ios",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json}": [
      "prettier --write"
    ]
  },
  "private": true
}
